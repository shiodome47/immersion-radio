# Local development uses `.dev.vars`, not `.env`. Copy this to `.dev.vars`:
#
#   cp .env.example .dev.vars
#
# In production these are Worker secrets, set with `wrangler secret put <NAME>`.
# Never commit real values — .dev.vars is gitignored for this reason.

# Locks the station. Without it the Worker refuses to serve anything private,
# because this app holds whatever you send it, meeting transcripts included.
ACCESS_PASSWORD=

# Signs the session cookie. Any long random string:
#   openssl rand -hex 32
SESSION_SECRET=

# Writes the show's scripts. Leave empty to run on canned mock scripts.
ANTHROPIC_API_KEY=
