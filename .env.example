# Copy this file to `.env` and fill in your key.

# Your Anthropic API key. Get one at https://console.anthropic.com/
# Without a key, Immerse FM still runs in a limited "mock" mode so you can
# try the interface — but real i+1 script generation needs a key.
ANTHROPIC_API_KEY=

# Model used to generate radio segments. Change if your account has a
# different model available.
IMMERSE_MODEL=claude-sonnet-5

# Port for the local server.
PORT=3000
