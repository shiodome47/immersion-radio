# Copy this file to `.env` and fill in your key.

# Your Anthropic API key — used to write the show's scripts.
# https://console.anthropic.com/
# Without it, Immerse FM still boots and plays canned mock scripts so you can
# see the format working before spending anything.
ANTHROPIC_API_KEY=

# Model that writes the two-host dialogue.
IMMERSE_MODEL=claude-sonnet-5

# Port for the local server.
PORT=3000
